{
  "name": "@peta-belajar/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:verify": "tsx scripts/verify-db.ts"
  },
  "dependencies": {
    "@peta-belajar/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.36.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "openai": "^7.30.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.15.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}