# Server-side only (apps/api). NEVER expose to the frontend bundle.
# OpenAI API key, or key for an OpenAI-compatible gateway.
OPENAI_API_KEY=sk-your-key-here
# Optional: OpenAI-compatible gateway base URL (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://ai.qenoxit.site/api/v1
# Model used for roadmap generation
OPENAI_MODEL=gpt-4o-mini
# API server
PORT=4000
# SQLite database file location
DATABASE_URL=./data/peta-belajar.db
# Demo auth session secret
SESSION_SECRET=change-me-in-production
